# Python
__pycache__/
*.py[cod]
*$py.class
build/
dist/

# Virtual Environment
venv/
ENV/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
Thumbs.db
desktop.ini

# Project specific
# Exclude snapshots folder (contains user-specific data extracts)
Vribbels/snapshots/

# User-state folder. The bundled defaults live in `default_settings/`
# (tracked) and are merged into `settings/` on first run by
# defaults_sync.py. Never track the user's `settings/` -- it holds
# their own presets, char assignments, optimizer config, etc.
Vribbels/settings/

# Working scratch, not documentation. `tasks.md` is a queue rather than
# a roadmap, and the other two are notes for work in flight -- a plan
# graduates into `past_plans/` when its work lands, and `paused_task.md`
# is written to be deleted. `CLAUDE.md`, `docs/` and `past_plans/` are
# tracked.
# `.claude/*` rather than `.claude/`: a negation cannot re-include
# anything under an excluded DIRECTORY, and `rules/` is repo guidance
# that belongs in the history beside `CLAUDE.md`. Settings stay out --
# `settings.local.json` holds one machine's choices.
.claude/*
!.claude/rules/
plan.md
tasks.md
paused_task.md
RELEASE_NOTES.md

# Git worktrees (isolated workspaces for parallel development)
.worktrees/

# Build ARTEFACTS. `build/` and `dist/` are covered by the Python block
# above. The .spec belongs here because `zCreate exe.bat` passes
# `--add-data` on the command line and overwrites it every run -- the
# bat is the build DEFINITION and is tracked, the .spec is its output.
*.spec

# Tcl/Tk's library, unpacked out of the interpreter's own zips by
# `build_tcl/prepare_tcl_data.py` so PyInstaller can bundle it. A copy
# of the installed Python's files, rebuilt every run.
Vribbels/build_tcl/_tcl_data/
Vribbels/build_tcl/_tk_data/

# I'm normal
.old/
_tmp/